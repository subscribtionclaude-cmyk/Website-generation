# Caching headers for hosts that read Netlify-style _headers files (Netlify, Cloudflare Pages).
# The service worker must always be revalidated so a release reaches visitors; hashed build
# assets never change.
/sw.js
  Cache-Control: no-cache
/offline.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
