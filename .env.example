# ─────────────────────────────────────────────────────────────
# MALEK STORE — environment
# Copy to `.env.local` and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── 1. Frontend (public) ─────────────────────────────────────
# Everything prefixed VITE_ is embedded in the public JS bundle, so only
# PUBLIC values belong here (never a service-role / secret key).
# `vite build` refuses VITE_* variables whose name or value looks like a
# secret, and `npm run check:secrets` scans the built files.

# Data mode: `demo` | `live`
#   demo — runs entirely on bundled seed/demo data (no backend needed).
#   live — requires the Supabase variables below; the app refuses to
#          start in live mode without them (it never silently falls back to demo).
# If left empty: `live` when Supabase is configured, otherwise `demo`.
VITE_DATA_MODE=demo

# Supabase project URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Supabase PUBLIC client key: the legacy "anon" key or the newer
# "publishable" key (sb_publishable_...). Row Level Security protects data.
# The app refuses to start if a service-role / secret key is supplied here.
VITE_SUPABASE_ANON_KEY=

# Public site origin used for canonical URLs, auth redirects and sitemaps,
# e.g. https://malekstore.example (optional; defaults to window.location.origin).
VITE_SITE_URL=

# ── 2. Server-only secrets (Phase 09 optional integrations) ──
# These are NOT read by the frontend and must NEVER be prefixed VITE_.
# Set them on the server runtime only (Supabase Edge Function secrets):
#   supabase secrets set NAME=value
# They are listed here by NAME only, as documentation. Leave them unset
# unless you enable the matching integration in Admin → Integrations.
# Public settings (IDs, URLs, template names) are entered in the admin,
# not here. Every integration is optional and off by default.
#
#   WhatsApp Business (Cloud API): WHATSAPP_ACCESS_TOKEN, WHATSAPP_WEBHOOK_SECRET, WHATSAPP_VERIFY_TOKEN
#   SMS gateway:                    SMS_API_KEY
#   Email (SMTP / HTTP API):        SMTP_PASSWORD, EMAIL_API_KEY
#   Odoo (read-only import):        ODOO_API_KEY
#   POS:                            POS_API_KEY
#   Courier:                        COURIER_API_KEY
#   AI content assistant:           AI_API_KEY
#   External search:                SEARCH_API_KEY
#   External storage:               STORAGE_ACCESS_KEY_ID, STORAGE_SECRET_ACCESS_KEY
#   Off-site backup:                BACKUP_ACCESS_KEY_ID, BACKUP_SECRET_ACCESS_KEY
#
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# to Edge Functions automatically — never copy the service-role key anywhere else.
#
# Optional, for `supabase start` only (local social sign-in; see supabase/config.toml):
#   SUPABASE_AUTH_GOOGLE_CLIENT_ID, SUPABASE_AUTH_GOOGLE_SECRET,
#   SUPABASE_AUTH_APPLE_CLIENT_ID, SUPABASE_AUTH_APPLE_SECRET
# Hosted projects configure Google / Apple in Supabase → Authentication → Providers.
