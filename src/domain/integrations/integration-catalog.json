{
  "$comment": "Phase 09 integrations catalog — the single contract shared by the TypeScript registry and the database (app.integration_catalog(); verified by scripts/db/check-contracts.mjs). `settings` are PUBLIC / non-secret configuration stored in Postgres. `secrets` are the NAMES of server-only environment variables read by the server runtime (Supabase Edge Functions) — their values are never stored in the database, the frontend or the repository. `adapter`: implemented = a server/client adapter exists (untested against a live account until credentials are configured); contract = the interface and a mock exist, a concrete adapter is added when a provider is chosen.",
  "integrations": [
    {
      "key": "whatsapp",
      "category": "messaging",
      "channel": "whatsapp",
      "check": "server",
      "subscription": "may_require",
      "fallback": "manual_whatsapp",
      "providers": [
        {
          "key": "meta_cloud",
          "adapter": "implemented",
          "capabilities": ["message.template", "message.text", "delivery.status", "webhook"]
        }
      ],
      "settings": [
        {
          "key": "phoneNumberId",
          "type": "string",
          "required": true,
          "pattern": "^[0-9]{5,30}$"
        },
        {
          "key": "businessAccountId",
          "type": "string",
          "required": false,
          "pattern": "^[0-9]{5,30}$"
        },
        {
          "key": "graphVersion",
          "type": "string",
          "required": true,
          "pattern": "^v[0-9]{1,3}\\.[0-9]{1,2}$"
        }
      ],
      "secrets": ["WHATSAPP_ACCESS_TOKEN", "WHATSAPP_WEBHOOK_SECRET", "WHATSAPP_VERIFY_TOKEN"],
      "syncDomains": [],
      "data": ["customer_phone", "message_text", "order_or_request_reference"]
    },
    {
      "key": "sms",
      "category": "messaging",
      "channel": "sms",
      "check": "server",
      "subscription": "required",
      "fallback": "manual_contact",
      "providers": [
        {
          "key": "http_gateway",
          "adapter": "contract",
          "capabilities": ["message.text"]
        }
      ],
      "settings": [
        {
          "key": "senderId",
          "type": "string",
          "required": true,
          "pattern": "^[A-Za-z0-9 ]{2,11}$"
        },
        {
          "key": "endpoint",
          "type": "url",
          "required": true
        }
      ],
      "secrets": ["SMS_API_KEY"],
      "syncDomains": [],
      "data": ["customer_phone", "message_text"]
    },
    {
      "key": "email",
      "category": "messaging",
      "channel": "email",
      "check": "server",
      "subscription": "may_require",
      "fallback": "in_app_only",
      "providers": [
        {
          "key": "smtp",
          "adapter": "contract",
          "capabilities": ["message.email"]
        },
        {
          "key": "http_api",
          "adapter": "contract",
          "capabilities": ["message.email", "delivery.status"]
        }
      ],
      "settings": [
        {
          "key": "fromAddress",
          "type": "email",
          "required": true
        },
        {
          "key": "fromName",
          "type": "string",
          "required": false,
          "pattern": "^.{1,80}$"
        },
        {
          "key": "replyTo",
          "type": "email",
          "required": false
        }
      ],
      "secrets": ["EMAIL_API_KEY", "SMTP_PASSWORD"],
      "syncDomains": [],
      "data": ["customer_email", "message_text"]
    },
    {
      "key": "google_analytics",
      "category": "analytics",
      "check": "client",
      "subscription": "free",
      "fallback": "built_in_analytics",
