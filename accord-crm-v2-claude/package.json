{
  "name": "accord-crm-v2-claude",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ACCORD CRM V2 — Claude independent version (static React + Supabase)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "bash scripts/test-sql.sh",
    "test:e2e": "node tests/e2e/run.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "serve:dist": "node scripts/serve-static.mjs dist 4173",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^0.454.0",
